{
	# Port 80 is not published (it belongs to another project on this host), so no HTTP->HTTPS
	# redirect and no HTTP-01 challenge: certificates come from TLS-ALPN-01 on 443 only.
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

{$APIDRIFT_HOST} {
	tls {
		issuer acme {
			email zachzap2@gmail.com
			disable_http_challenge
		}
	}
	reverse_proxy web:8000
}
